# Environment variables for the IMED ERP application in Coolify (Environment Variables tab). Each one marked
# "secret" is entered there and nowhere else: never in this repository, never in chat. Values here are placeholders.

# --- required (the stack refuses to start without them) ---
DB_ROOT_PASSWORD=                # secret: MariaDB root, 32+ random characters (openssl rand -base64 32)

# --- the site ---
FRAPPE_SITE_NAME=frontend        # the site's folder name in the sites volume (the backup's name; keep it)
IMED_IMAGE_TAG=coolify           # tag of the image Coolify builds from deploy/Containerfile

# --- tuning (defaults are right for a 4 vCPU / 16 GB VPS shared with other apps) ---
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
UPSTREAM_REAL_IP_ADDRESS=172.16.1.0/24   # Coolify's proxy network on this VPS (docker network inspect coolify)

# --- backups off the server (the scheduled task in docs/PRODUCTION_DEPLOYMENT_COOLIFY.md, section 7) ---
RESTIC_REPOSITORY=               # e.g. s3:https://<endpoint>/<bucket>/imed-erp
RESTIC_PASSWORD=                 # secret: the repository's encryption password; losing it loses the backups
AWS_ACCESS_KEY_ID=               # secret: the bucket's key
AWS_SECRET_ACCESS_KEY=           # secret
